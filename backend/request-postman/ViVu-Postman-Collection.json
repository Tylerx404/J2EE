					}
				},
				{
					"name": "Tạo Ví Mới",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('walletId', jsonData.id);",
									"    console.log('✅ Ví mới đã tạo! ID:', jsonData.id);",
									"    console.log('Tên:', jsonData.name);",
									"    console.log('Số dư:', jsonData.balance);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Ví tiết kiệm\",\n    \"initialBalance\": 5000000,\n    \"currency\": \"VND\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/wallets",
							"host": ["{{baseUrl}}"],
							"path": ["api", "wallets"]
						},
						"description": "✨ Tạo ví mới với SỐ DƯ BAN ĐẦU.\n\n**initialBalance**: Số dư ban đầu do user tự nhập (VD: 5.000.000 VNĐ)\n**currency**: VND (mặc định nếu không truyền)\n\n💡 Sau này mỗi khi có giao dịch:\n- Thu nhập (+) → balance tăng\n- Chi tiêu (-) → balance giảm\n- Công thức: balance = initialBalance + ΣINCOME - ΣEXPENSE"
					}
				},
				{
					"name": "Xóa Ví",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/wallets/{{walletId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "wallets", "{{walletId}}"]
						},
						"description": "Xóa ví theo ID.\n\n**Lưu ý**: Không xóa được nếu ví còn giao dịch. Phải xóa hết giao dịch trước."
					}
				}
			]
		},
