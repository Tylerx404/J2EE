					}
				},
				{
					"name": "Lấy Ví Theo ID",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/wallets/{{walletId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "wallets", "{{walletId}}"]
